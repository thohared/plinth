diff --git a/src/scene/warmup.ts b/src/scene/warmup.ts
new file mode 100644
index 0000000..8edad8d
--- /dev/null
+++ b/src/scene/warmup.ts
@@ -0,0 +1,34 @@
+import { Mesh, OrthographicCamera, PlaneGeometry, Scene, Vector4, type Material, type WebGLRenderer, type WebGLRenderTarget } from 'three';
+
+/** Compile the same fullscreen materials in their actual output context. */
+export async function warmupMaterials(renderer: WebGLRenderer,
+  passes: readonly { material: Material; target: WebGLRenderTarget | null }[],
+  cancelled: () => boolean): Promise<void> {
+  const geometry = new PlaneGeometry(2, 2);
+  const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
+  try {
+    const pending = passes.map(async pass => {
+      if (cancelled()) return;
+      const scene = new Scene();
+      scene.add(new Mesh(geometry, pass.material));
+      const target = renderer.getRenderTarget();
+      const viewport = renderer.getViewport(new Vector4());
+      const scissor = renderer.getScissor(new Vector4());
+      const scissorTest = renderer.getScissorTest();
+      try {
+        renderer.setRenderTarget(pass.target);
+        return renderer.compileAsync(scene, camera);
+      } finally {
+        // compileAsync selects the variant synchronously. Never hold shared
+        // renderer state while its completion poll yields to other work.
+        renderer.setRenderTarget(target);
+        renderer.setViewport(viewport); renderer.setScissor(scissor);
+        renderer.setScissorTest(scissorTest);
+      }
+    });
+    // Start the independent programs together; wait for all completions even
+    // when one fails so temporary geometry never outlives its owner.
+    const results = await Promise.allSettled(pending);
+    for (const result of results) if (result.status === 'rejected') throw result.reason;
+  } finally { geometry.dispose(); }
+}
